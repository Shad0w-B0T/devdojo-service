<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <!-- Ensure UTF-8 encoding -->
  <property name="charset" value="UTF-8"/>

  <!-- Naming conventions for classes, methods, and variables -->
  <module name="TreeWalker">
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- Enforce naming convention for constants (ALL_CAPS) -->
    <module name="ConstantName">
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>

    <!-- Method naming convention (camelCase), ignore methods starting with 'test' -->
    <module name="MethodName">
      <property name="format" value="^(test.*|should.*|[a-z][a-zA-Z0-9]*)$"/>
    </module>

    <!-- Enforce variable naming convention (camelCase) -->
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>

    <!-- Enforce class naming convention (PascalCase) -->
    <module name="TypeName">
      <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
      <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
    </module>

    <module name="ParameterName">
      <property name="format" value="^[a-z]([a-z0-9][a-zA-Z0-9]*)?$"/>
    </module>

    <!-- Enforce 2-space indentation -->
    <module name="Indentation">
      <property name="basicOffset" value="2"/>
      <property name="tabWidth" value="2"/>
      <property name="lineWrappingIndentation" value="2"/>
      <property name="throwsIndent" value="2"/>
      <property name="caseIndent" value="2"/>
    </module>

    <!-- Ensure proper spacing around operators -->
    <module name="WhitespaceAround"/>
    <module name="NoWhitespaceBefore">
      <property name="tokens" value="COMMA, SEMI, POST_INC, POST_DEC, DOT, LABELED_STAT, METHOD_REF"/>
      <property name="allowLineBreaks" value="true"/>
    </module>


    <module name="OneStatementPerLine"/>
    <module name="ArrayTypeStyle"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>

    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapDot"/>
      <property name="tokens" value="DOT"/>
      <property name="option" value="nl"/>
    </module>
    <module name="SeparatorWrap">
      <property name="id" value="SeparatorWrapComma"/>
      <property name="tokens" value="COMMA"/>
      <property name="option" value="EOL"/>
    </module>

    <!-- Ensure that blocks (if, while, etc.) are always enclosed with braces -->
    <module name="NeedBraces"/>

    <!-- Disallow wildcards in import statements (i.e., use specific imports) -->
    <module name="AvoidStarImport">
      <property name="allowClassImports" value="true"/>
      <property name="excludes" value="java.io,java.net"/>
    </module>

    <!-- Ensure imports are ordered alphabetically and separated properly -->
    <module name="CustomImportOrder">
    </module>

    <!-- Avoid empty catch blocks unless explicitly allowed -->
    <module name="EmptyCatchBlock"/>

    <!-- Ensure methods are not too complex (cyclomatic complexity <= 10) -->
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
      <property name="severity" value="warning"/>
    </module>

    <!-- Enforce a maximum method length to maintain readability (e.g., 100 lines) -->
    <module name="MethodLength">
      <property name="max" value="100"/>
      <property name="severity" value="warning"/>
    </module>

    <!-- Ensure classes do not become too large or unwieldy -->
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
      <property name="severity" value="warning"/>
    </module>

    <!-- Limit nested blocks (e.g., ifs within loops within another block) -->
    <module name="NPathComplexity">
      <property name="max" value="30"/>
      <property name="severity" value="warning"/>
    </module>
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
      <property name="tokens" value="LITERAL_FINALLY"/>
    </module>

    <!-- Require Javadoc comments for public and protected methods/classes -->
    <module name="JavadocMethod"/>
    <module name="InvalidJavadocPosition"/>

    <!-- Disallow magic numbers (hardcoded numbers in code) -->
    <module name="MagicNumber">
      <property name="ignoreNumbers" value="0,1,-1"/>
    </module>

    <!-- Enforce that switch statements have default case -->
    <module name="MissingSwitchDefault"/>

    <!-- Enforce final for method parameters to avoid unintended modification -->
    <module name="FinalParameters"/>

    <module name="AbbreviationAsWordInName">
      <property name="tokens" value="VARIABLE_DEF"/>
      <property name="ignoreStatic" value="true"/>
      <property name="allowedAbbreviationLength" value="1"/>
      <property name="allowedAbbreviations" value="CSV"/>
    </module>
  </module>

  <!-- Ensure lines do not exceed a set maximum length (e.g., 120 characters) -->
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="severity" value="warning"/>
    <property name="ignorePattern"
              value="^package.*|^import.*|href\s*=\s*&quot;[^&quot;]*&quot;|http://|https://|ftp://"/>
  </module>

  <!-- Checks for file-level issues -->
  <module name="FileTabCharacter">
    <!-- Disallow tab characters in files (use spaces instead) -->
    <property name="eachLine" value="true"/>
  </module>

  <!-- Ensure files end with a single empty line -->
  <module name="NewlineAtEndOfFile"/>

  <!-- Limit file length to a certain number of lines (e.g., 2000 lines) -->
  <module name="FileLength">
    <property name="max" value="2000"/>
  </module>
</module>