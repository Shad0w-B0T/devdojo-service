enum UserRole {
    GUEST
    USER
    STUDENT
    PROFESSOR
    ADMIN
}

type User implements DateAuditable{
    id: ID!
    email: String!
    name: String!
    role: UserRole!
    active: Boolean!
    lastLogin: Long!
    profilePublic: Boolean!
    createdAt: Long!
    updatedAt: Long!
}

input UpdateUserName {
    userId: ID!
    name: String!
}

input UpdateUserRole {
    userId: ID!
    role: UserRole!
}

input UpdateUserProfileVisibility {
    userId: ID!
    profilePublic: Boolean!
}

input GetUser {
    userId: ID!
}

extend type Query {
    users: [User!]!
    usersActiveCount: Int!
    user(input: GetUser!): User!
    userSelf: User!
}

extend type Mutation {
    updateUserRole(input: UpdateUserRole!): User!
    updateUserVisibility(input: UpdateUserProfileVisibility!): User!
}

