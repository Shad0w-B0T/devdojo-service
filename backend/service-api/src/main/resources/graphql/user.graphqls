enum UserRole {
    GUEST
    USER
    STUDENT
    PROFESSOR
    ADMIN
}

type User implements DateAuditable{
    id: ID!
    email: String!
    name: String!
    applicationRole: UserRole!
    active: Boolean!
    lastLogin: Long!
    createdAt: Long!
    updatedAt: Long!
}

input UpdateUserName {
    userId: ID!
    name: String!
}

input UpdateUserRole {
    userId: ID!
    applicationRole: UserRole!
}

extend type Query {
    users: [User!]!
    userSelf: User!
}

extend type Mutation {
    updateUserName(input: UpdateUserName!): User!
    updateUserRole(input: UpdateUserRole!): User!
}

