<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>[%d] %-5level %-36.36logger{36} - %msg    %replace(%X{user}){'^(.+)$', '--(Executor:$1)'} %replace(%X{method}){'^(.+)$', '--(Method:$1)'} %replace(%X{uri}){'^(.+)$', '--(URI:$1)'}%n</pattern>
    </encoder>
  </appender>

  <root level="info">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>